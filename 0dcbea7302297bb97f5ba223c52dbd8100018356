    {
      "unresolved": false,
      "key": {
        "uuid": "b96000d9_b6786f90",
        "filename": "transport/transport-http/src/main/java/org/opendaylight/netconf/transport/http/HTTPServerSession.java",
        "patchSetId": 8
      },
      "lineNbr": 138,
      "author": {
        "id": 9173
      },
      "writtenOn": "2026-08-25T19:49:00Z",
      "side": 1,
      "message": "This is required by the configured maxInitialLineLength and maxHeaderSize introduced in this patch. Netty reports violations of either limit by forwarding a partially decoded request with a failed decoderResult(), rather than propagating an exception through the pipeline. The session must reject the request before reading its incomplete URI or headers, returning 414 or 431 for these limit violations and 400 for other decoding failures. This prevents RESTCONF from processing a partially decoded request.",
      "parentUuid": "a3c7f003_9a925cd1",
      "revId": "0dcbea7302297bb97f5ba223c52dbd8100018356",
      "serverId": "7fc14799-209e-464c-9743-7a06c2c21a81"
